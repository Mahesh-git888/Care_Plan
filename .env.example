# Portea Care Plan — environment variables
# Copy to .env.local for the Next.js app, and to backend/.env for the FastAPI service.

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/portea
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ---

# Public site URL — used for canonical, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://care.portea.com

# Intake API endpoint. Leave blank to use the local Next.js /api/v1/intake
# fallback. In production, point this at the FastAPI service.
NEXT_PUBLIC_INTAKE_API_URL=http://localhost:8000/api/v1/intake

# Portea WhatsApp Business number in E.164 digits-only form (no '+').
# Defaults to 919606111000 if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=919606111000

# Google Tag Manager container ID. Defaults to GTM-MQGX3H46 (the live Portea
# container) when unset. Override here for a different environment, or set to
# an empty string to disable GTM during local development. Events pushed to
# dataLayer: form_start, generate_lead, click_call, whatsapp_click, scroll_90.
NEXT_PUBLIC_GTM_ID=

# --- Lead storage (Postgres) -----------------------------------------------
#
# All leads, password overrides and the login audit log live in Postgres.
# Tables are created automatically on first use (CREATE TABLE IF NOT EXISTS).
#
# POSTGRES_URL is set automatically when you add a Postgres database through
# the Vercel dashboard (Storage tab, Neon integration). If you host Postgres
# elsewhere, paste the connection string here. DATABASE_URL also works.
#
# Example: postgres://user:password@host.neon.tech/dbname?sslmode=require
POSTGRES_URL=

# --- Portea CRM integration (FUTURE, leave blank for now) ------------------
# Placeholders for the day Portea engineering provides their own CRM intake
# endpoint. When set, every new lead is also POSTed there. Best-effort.
PORTEA_CRM_API_URL=
PORTEA_CRM_API_KEY=

# --- Admin auth ------------------------------------------------------------
#
# Two ways to configure admin sign-in:
#
# 1) PORTEA_USERS_JSON (preferred): an array of users with PBKDF2 password
#    hashes. Each user gets per-account sign-in. Use scripts/hash-password.mjs
#    to generate the password_hash strings.
#
#    Example:
#    PORTEA_USERS_JSON=[{"id":"u_meera","email":"meera@portea.com",
#      "name":"Meera","role":"cm","password_hash":"pbkdf2$210000$..."},
#      {"id":"u_admin","email":"admin@portea.com","name":"Admin",
#      "role":"admin","password_hash":"pbkdf2$210000$..."}]
#
# 2) PORTEA_ADMIN_PASSWORD (legacy, only used if PORTEA_USERS_JSON is empty):
#    a single shared password. Quick to set up but every admin shares one
#    credential. Remove this once PORTEA_USERS_JSON is in place.
#
# PORTEA_AUTH_SECRET is the HMAC key used to sign session cookies. Must be
# at least 16 characters; a 32+ character random string is recommended. If
# you change it, every existing session is invalidated and users sign back in.
PORTEA_USERS_JSON=
PORTEA_ADMIN_PASSWORD=change-me-to-a-strong-password
PORTEA_AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---------------------------------------------------------------------------
# Recommended ad URL pattern (Meta / Google):
#
#   https://care.portea.com/dementia
#     ?utm_source=meta
#     &utm_medium=paid
#     &utm_campaign=dementia-bangalore-april
#     &utm_content=carousel-1
#
# UTM params are auto-captured client-side and attached to every intake and
# every Call/WhatsApp click on the landing page.
# ---------------------------------------------------------------------------
